---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** Override viewport-level theme color (used by mobile chrome). */
  themeColor?: string;
}

const {
  title,
  description = "Nook 502 — 友達と、暮らしのお下がり。502号室のちいさな市場。",
  themeColor = "#f4efe6",
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+Antique:wght@300;400;500;700;900&display=swap"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
