---
interface Props {
  accent?: string;
}

const { accent } = Astro.props;
---

<div class="section-label">
  <span class="bar" style={accent ? `background:${accent}` : undefined}></span>
  <span class="text"><slot /></span>
  <span class="rule"></span>
</div>

<style>
  .section-label {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 14px 16px 6px;
  }

  .bar {
    width: 4px;
    height: 14px;
    background: var(--color-primary);
    border: 1px solid var(--color-ink);
    flex-shrink: 0;
  }

  .text {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }

  .rule {
    flex: 1;
    height: 1px;
    background: var(--color-line-soft);
  }
</style>
