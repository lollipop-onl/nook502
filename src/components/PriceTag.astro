---
interface Props {
  price: number;
  size?: "md" | "lg";
}

const { price, size = "md" } = Astro.props;
const formatted = price.toLocaleString("ja-JP");
const isFree = price === 0;
const ariaLabel = isFree ? "価格 無料" : `価格 ¥${formatted}`;
---

<div class:list={["price", `price--${size}`, isFree && "price--free"]} aria-label={ariaLabel}>
  {
    isFree ? (
      <span class="free">無料</span>
    ) : (
      <>
        <span class="yen" aria-hidden="true">¥</span>
        <span class="value">{formatted}</span>
      </>
    )
  }
</div>

<style>
  .price {
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
  }

  .yen {
    color: var(--color-primary);
    font-weight: 700;
  }

  .value {
    font-weight: 900;
    color: var(--color-ink);
    letter-spacing: -0.5px;
  }

  .free {
    font-weight: 900;
    color: var(--color-primary);
    letter-spacing: 0.5px;
  }

  .price--md .yen {
    font-size: 11px;
  }

  .price--md .value,
  .price--md .free {
    font-size: 16px;
  }

  .price--lg .yen {
    font-size: 14px;
  }

  .price--lg .value,
  .price--lg .free {
    font-size: 28px;
  }
</style>
