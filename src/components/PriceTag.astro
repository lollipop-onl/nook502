---
interface Props {
  price: number;
  size?: "md" | "lg";
}

const { price, size = "md" } = Astro.props;
const formatted = price.toLocaleString("ja-JP");
---

<div class:list={["price", `price--${size}`]} aria-label={`価格 ¥${formatted}`}>
  <span class="yen" aria-hidden="true">¥</span>
  <span class="value">{formatted}</span>
</div>

<style>
  .price {
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
    background: var(--color-card);
    border: 1.6px solid var(--color-ink);
    border-radius: 8px;
    background-image: repeating-linear-gradient(
      45deg,
      rgb(from var(--color-primary) r g b / 0.08) 0 1.2px,
      transparent 1.2px 6px
    );
  }

  .yen {
    color: var(--color-primary);
    font-weight: 700;
  }

  .value {
    font-weight: 900;
    color: var(--color-ink);
    letter-spacing: -0.5px;
  }

  .price--md {
    padding: 4px 8px;
  }

  .price--md .yen {
    font-size: 11px;
  }

  .price--md .value {
    font-size: 16px;
  }

  .price--lg {
    padding: 8px 12px;
  }

  .price--lg .yen {
    font-size: 14px;
  }

  .price--lg .value {
    font-size: 28px;
  }
</style>
