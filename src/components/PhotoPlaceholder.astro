---
import { Camera } from "@lucide/astro";

interface Props {
  ratio?: string;
  label?: string;
  badge?: string | number;
}

const { ratio = "4 / 3", label, badge } = Astro.props;
---

<div class="photo bg-stripe" style={`aspect-ratio:${ratio}; --stripe-opacity:0.18; --stripe-color:var(--color-primary); --stripe-size:10px;`}>
  <Camera class="icon" aria-hidden="true" />
  {label && <span class="label">{label}</span>}
  {badge != null && <span class="badge">{badge}</span>}
</div>

<style>
  .photo {
    width: 100%;
    background-color: var(--color-paper-deep);
    border: 1.6px solid var(--color-ink);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 6px;
    color: var(--color-ink-soft);
    position: relative;
  }

  .icon {
    width: 28px;
    height: 28px;
    stroke-width: 1.6;
  }

  .label {
    font-size: 11px;
    font-weight: 600;
  }

  .badge {
    position: absolute;
    top: 6px;
    right: 6px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 800;
    background: var(--color-card);
    color: var(--color-ink);
    border: 1.4px solid var(--color-ink);
    border-radius: 999px;
  }
</style>
