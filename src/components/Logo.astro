---
interface Props {
  size?: number;
  showWordmark?: boolean;
}

const { size = 28, showWordmark = true } = Astro.props;
---

<div class="logo" style={`--logo-size:${size}px`}>
  <svg
    viewBox="0 0 56 40"
    fill="none"
    stroke="currentColor"
    stroke-width="1.4"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M10 18 L28 4 L46 18 L46 36 L10 36 Z"></path>
    <path d="M16 22 H40"></path>
    <path d="M28 4 V12"></path>
    <ellipse cx="28" cy="14" rx="3" ry="2" fill="var(--color-primary)" stroke="currentColor"></ellipse>
    <rect x="18" y="16" width="5" height="6" fill="var(--color-accent)"></rect>
    <circle cx="28" cy="19" r="2.5" fill="var(--color-secondary)"></circle>
    <rect x="33" y="17" width="5" height="5" fill="var(--color-primary)"></rect>
  </svg>
  {
    showWordmark && (
      <div class="wordmark">
        <span class="brand">Nook</span>
        <span class="suffix">— 502 —</span>
      </div>
    )
  }
</div>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-ink);
  }

  svg {
    width: calc(var(--logo-size) * 1.4);
    height: var(--logo-size);
    flex-shrink: 0;
  }

  .wordmark {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .brand {
    font-size: calc(var(--logo-size) * 0.7);
    font-weight: 800;
    letter-spacing: -0.5px;
    color: var(--color-ink);
  }

  .suffix {
    font-size: calc(var(--logo-size) * 0.32);
    font-weight: 600;
    letter-spacing: 4px;
    color: var(--color-ink-soft);
    margin-top: 2px;
  }
</style>
