---
import type { AstroComponent } from "@lucide/astro";

interface Props {
  /** Renders a `<button>` by default. Pass `as="a"` for an anchor (uses `href`). */
  as?: "button" | "a";
  href?: string;
  type?: "button" | "submit" | "reset";
  kind?: "primary" | "secondary" | "danger" | "ghost";
  size?: "sm" | "md" | "lg";
  full?: boolean;
  disabled?: boolean;
  icon?: AstroComponent;
  name?: string;
  value?: string;
  form?: string;
}

const {
  as = "button",
  href,
  type = "button",
  kind = "primary",
  size = "md",
  full = false,
  disabled = false,
  icon: Icon,
  name,
  value,
  form,
} = Astro.props;

const classes = ["btn", `btn--${kind}`, `btn--${size}`, "press-hard"];
if (full) classes.push("btn--full");
---

{
  as === "a" ? (
    <a class:list={classes} href={href}>
      {Icon && <Icon class="icon" aria-hidden="true" />}
      <span class="label">
        <slot />
      </span>
    </a>
  ) : (
    <button
      class:list={classes}
      type={type}
      disabled={disabled}
      name={name}
      value={value}
      form={form}
    >
      {Icon && <Icon class="icon" aria-hidden="true" />}
      <span class="label">
        <slot />
      </span>
    </button>
  )
}

<style>
  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 1.8px solid var(--color-ink);
    border-radius: 10px;
    cursor: pointer;
    font-weight: 700;
    letter-spacing: 0.2px;
    font-family: inherit;
    text-decoration: none;
    box-shadow: var(--shadow-hard-lg);
  }

  .btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .btn--full {
    width: 100%;
  }

  .btn--sm {
    padding: 6px 12px;
    font-size: 12px;
  }
  .btn--sm .icon {
    width: 14px;
    height: 14px;
  }

  .btn--md {
    padding: 10px 16px;
    font-size: 14px;
  }
  .btn--md .icon {
    width: 16px;
    height: 16px;
  }

  .btn--lg {
    padding: 14px 22px;
    font-size: 15px;
  }
  .btn--lg .icon {
    width: 17px;
    height: 17px;
  }

  .btn--primary {
    background: var(--color-primary);
    color: var(--color-card);
  }

  .btn--secondary {
    background: var(--color-card);
    color: var(--color-ink);
  }

  .btn--danger {
    background: var(--color-danger);
    color: var(--color-card);
  }

  .btn--ghost {
    background: transparent;
    color: var(--color-ink);
    box-shadow: none;
    border-color: transparent;
  }

  .icon {
    flex-shrink: 0;
    stroke-width: 2;
  }
</style>
