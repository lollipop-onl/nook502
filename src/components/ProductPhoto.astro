---
/**
 * ProductPhoto — renders an actual photo if provided, otherwise falls
 * back to PhotoPlaceholder (the camera-icon striped tile).
 *
 * Photos are served from `/images/{r2_key}` (Worker streaming endpoint).
 */
import PhotoPlaceholder from "./PhotoPlaceholder.astro";

interface Props {
  src?: string | null;
  alt: string;
  ratio?: string;
  badge?: string | number;
  loading?: "eager" | "lazy";
}

const { src, alt, ratio = "4 / 3", badge, loading = "lazy" } = Astro.props;
---

{
  src ? (
    <div class="photo" style={`aspect-ratio:${ratio}`}>
      <img src={src} alt={alt} loading={loading} decoding="async" />
      {badge != null && <span class="badge">{badge}</span>}
    </div>
  ) : (
    <PhotoPlaceholder ratio={ratio} badge={badge} />
  )
}

<style>
  .photo {
    width: 100%;
    background: var(--color-paper-deep);
    border: 1.6px solid var(--color-ink);
    border-radius: 10px;
    overflow: hidden;
    position: relative;
  }

  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .badge {
    position: absolute;
    top: 6px;
    right: 6px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 800;
    background: var(--color-card);
    color: var(--color-ink);
    border: 1.4px solid var(--color-ink);
    border-radius: 999px;
  }
</style>
