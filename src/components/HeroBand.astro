---
interface Props {
  eyebrow?: string;
  count?: number;
}

const { eyebrow = "友達と、暮らしのお下がり", count } = Astro.props;
---

<div class="hero bg-stripe">
  <div class="eyebrow">{eyebrow}</div>
  <h1 class="title">
    502号室の<br />
    <span class="highlight">
      ちいさな市場
      <span class="underline" aria-hidden="true"></span>
    </span>
  </h1>
  {count != null && <div class="meta">{count}点が並んでいます · 連絡は LINE で</div>}
</div>

<style>
  .hero {
    padding: 20px 16px 16px;
    background-color: var(--color-paper-deep);
    --stripe-color: var(--color-primary);
    --stripe-opacity: 0.05;
    --stripe-size: 9px;
    border-bottom: 1.6px solid var(--color-ink);
  }

  .eyebrow {
    font-size: 11px;
    letter-spacing: 3px;
    color: var(--color-primary);
    font-weight: 800;
  }

  .title {
    margin: 6px 0 0;
    font-size: 28px;
    font-weight: 900;
    line-height: 1.15;
    letter-spacing: -0.5px;
  }

  .highlight {
    color: var(--color-primary);
    position: relative;
  }

  .underline {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    height: 6px;
    background: var(--color-primary-soft);
    z-index: -1;
  }

  .meta {
    margin-top: 10px;
    font-size: 12px;
    color: var(--color-ink-soft);
  }
</style>
