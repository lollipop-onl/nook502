---
import { ChevronDown } from "@lucide/astro";
import type { ProductStatus } from "../lib/status";
import { PRODUCT_STATUSES, statusLabel } from "../lib/status";

interface Props {
  productId: number;
  current: ProductStatus;
  /** Restrict the available choices (e.g. exclude `draft` from already-published items). */
  allowed?: readonly ProductStatus[];
}

const { productId, current, allowed = PRODUCT_STATUSES } = Astro.props;
const formId = `status-${productId}`;
---

<form
  id={formId}
  class="status-form"
  method="post"
  action={`/admin/items/${productId}/status`}
>
  <label class="status-label" data-current={current}>
    <select
      name="status"
      class="status-select"
      data-status-select
      aria-label="ステータスを変更"
    >
      {
        allowed.map((s) => (
          <option value={s} selected={s === current}>
            {statusLabel(s)}
          </option>
        ))
      }
    </select>
    <span class="status-text">{statusLabel(current)}</span>
    <ChevronDown class="caret" aria-hidden="true" />
  </label>
</form>

<script>
  // Submit the parent form on selection change so a status update is one tap.
  for (const el of document.querySelectorAll("select[data-status-select]")) {
    el.addEventListener("change", (e) => {
      const select = e.currentTarget as HTMLSelectElement;
      select.form?.submit();
    });
  }
</script>

<style>
  .status-form {
    margin: 0;
  }

  .status-label {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 22px 4px 8px;
    background: var(--color-card);
    border: 1.4px solid var(--color-ink);
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: var(--shadow-hard-sm);
  }

  .status-select {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    appearance: none;
    border: 0;
    background: transparent;
    font-family: inherit;
  }

  .caret {
    position: absolute;
    right: 6px;
    top: 50%;
    transform: translateY(-50%);
    width: 12px;
    height: 12px;
    stroke-width: 2.4;
    pointer-events: none;
  }

  .status-label[data-current="on_sale"] .status-text {
    color: var(--color-success);
  }
  .status-label[data-current="reserved"] .status-text {
    color: var(--color-warning);
  }
  .status-label[data-current="sold"] .status-text {
    color: var(--color-ink-soft);
  }
  .status-label[data-current="draft"] .status-text {
    color: var(--color-ink-soft);
  }
  .status-label[data-current="private"] .status-text {
    color: var(--color-ink-muted);
  }
</style>
