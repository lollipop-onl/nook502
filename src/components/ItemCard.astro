---
import type { Product, ProductImage } from "../lib/products";
import { imageUrl } from "../lib/images";
import PriceTag from "./PriceTag.astro";
import StatusChip from "./StatusChip.astro";
import ProductPhoto from "./ProductPhoto.astro";

interface Props {
  item: Product & { cover: ProductImage | null };
  hero?: boolean;
}

const { item, hero = false } = Astro.props;
const dim = item.status === "sold";
---

<a
  class:list={["card", hero && "card--hero", dim && "card--dim"]}
  href={`/items/${item.id}`}
>
  <div class="photo-wrap">
    <ProductPhoto
      src={item.cover ? imageUrl(item.cover.r2_key) : null}
      alt={item.title}
      ratio={hero ? "16 / 10" : "1 / 1"}
      loading={hero ? "eager" : "lazy"}
      plain
    />
    <div class="status">
      <StatusChip status={item.status} />
    </div>
  </div>
  <div class="body">
    <div class="brand">{item.brand}</div>
    <div class="title">{item.title}</div>
    <div class="price">
      <PriceTag price={item.price} />
    </div>
  </div>
</a>

<style>
  .card {
    display: block;
    text-decoration: none;
    color: inherit;
    background: var(--color-card);
    border: 1.6px solid var(--color-ink);
    border-radius: 12px;
    box-shadow: var(--shadow-hard-md);
    overflow: hidden;
    transition:
      transform 80ms ease,
      box-shadow 80ms ease;
  }

  .card:hover {
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0 0 var(--color-ink);
  }

  .card:active {
    transform: translate(2px, 2px);
    box-shadow: var(--shadow-hard-sm);
  }

  .card--hero {
    grid-column: span 2;
  }

  .card--dim {
    opacity: 0.55;
  }

  .photo-wrap {
    position: relative;
    border-bottom: 1.6px solid var(--color-ink);
  }

  .status {
    position: absolute;
    top: 8px;
    left: 8px;
  }

  .body {
    padding: 10px 12px 12px;
  }

  .brand {
    font-size: 10px;
    letter-spacing: 1.5px;
    color: var(--color-primary);
    font-weight: 800;
    text-transform: uppercase;
  }

  .title {
    font-size: 13px;
    font-weight: 700;
    line-height: 1.4;
    margin-top: 2px;
    color: var(--color-ink);
    text-wrap: pretty;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .price {
    margin-top: 8px;
  }
</style>
