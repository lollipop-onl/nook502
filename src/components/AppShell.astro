---
import { ChevronLeft } from "@lucide/astro";
import Logo from "./Logo.astro";

interface Props {
  /** When true, replaces the logo with a "戻る" link. */
  back?: boolean;
  backHref?: string;
  /** Title shown at center of header. */
  title?: string;
  /** Hide the header altogether (rare). */
  hideHeader?: boolean;
}

const { back = false, backHref = "/", title, hideHeader = false } = Astro.props;
---

<div class="shell">
  {
    !hideHeader && (
      <header class="shell__header">
        {back ? (
          <a class="back" href={backHref}>
            <ChevronLeft class="icon" aria-hidden="true" />
            戻る
          </a>
        ) : (
          <Logo size={24} />
        )}
        {title && <div class="title">{title}</div>}
        <div class="action">
          <slot name="header-action" />
        </div>
      </header>
    )
  }

  <div class="shell__body">
    <slot />
  </div>

  {
    Astro.slots.has("footer") && (
      <footer class="shell__footer">
        <slot name="footer" />
      </footer>
    )
  }
</div>

<style>
  .shell {
    width: 100%;
    max-width: 48rem; /* matches Tailwind v4 `screen-md` */
    margin-inline: auto;
    min-height: 100dvh;
    background: var(--color-paper);
    color: var(--color-ink);
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
  }

  @media (min-width: 48rem) {
    .shell {
      border-inline: 1.6px solid var(--color-ink);
    }
  }

  .shell__header {
    padding: 14px 16px;
    background: var(--color-card);
    border-bottom: 1.6px solid var(--color-ink);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 8px;
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .shell__header > :global(*:first-child) {
    justify-self: start;
  }

  .title {
    font-size: 14px;
    font-weight: 700;
    text-align: center;
  }

  .action {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
    padding: 0;
  }

  .back .icon {
    width: 18px;
    height: 18px;
    stroke-width: 2;
  }

  .shell__body {
    flex: 1;
    background: var(--color-paper);
    position: relative;
  }

  .shell__footer {
    padding: 12px 16px;
    background: var(--color-card);
    border-top: 1.6px solid var(--color-ink);
    position: sticky;
    bottom: 0;
    z-index: 10;
  }
</style>
