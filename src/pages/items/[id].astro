---
import { Copy, Link as LinkIcon } from "@lucide/astro";
import AppShell from "../../components/AppShell.astro";
import PrimaryButton from "../../components/PrimaryButton.astro";
import PriceTag from "../../components/PriceTag.astro";
import StatusChip from "../../components/StatusChip.astro";
import SectionLabel from "../../components/SectionLabel.astro";
import ProductPhoto from "../../components/ProductPhoto.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getProductById } from "../../lib/products";
import { imageUrl } from "../../lib/images";
import { isPublicStatus } from "../../lib/status";

const idParam = Astro.params.id ?? "";
const id = Number(idParam);

if (!Number.isInteger(id) || id <= 0) {
  return Astro.rewrite("/404");
}

const db = Astro.locals.runtime.env.DB;
const product = await getProductById(db, id);

if (!product || !isPublicStatus(product.status)) {
  return Astro.rewrite("/404");
}

const photos = product.images;
const hasPhotos = photos.length > 0;

const lineMessage = `[Nook 502] ${product.title} (¥${product.price.toLocaleString("ja-JP")}) について連絡したいです。\n${Astro.url.origin}/items/${product.id}`;
const lineUrl = `https://line.me/R/share?text=${encodeURIComponent(lineMessage)}`;
---

<BaseLayout title={`${product.title} — Nook 502`} description={product.description.slice(0, 120)}>
  <AppShell back backHref="/" title="商品詳細">
    <!-- Title block -->
    <section class="title-block">
      <div class="row">
        <div class="brand">{product.brand}</div>
        <StatusChip status={product.status} />
      </div>
      <h1 class="title">{product.title}</h1>
      <PriceTag price={product.price} size="lg" />
    </section>

    <!-- Description first (per design) -->
    <SectionLabel>商品の説明</SectionLabel>
    <p class="description">{product.description}</p>

    <!-- Photos -->
    {
      hasPhotos && (
        <>
          <SectionLabel>写真（{photos.length}枚）</SectionLabel>
          <div class="photo-block">
            <div class="photo-strip" id="photos">
              {photos.map((p, i) => (
                <div class="photo-slide" id={`photo-${i + 1}`}>
                  <ProductPhoto
                    src={imageUrl(p.r2_key)}
                    alt={`${product.title} 写真${i + 1}`}
                    ratio="4 / 3"
                    badge={`${i + 1}/${photos.length}`}
                    loading={i === 0 ? "eager" : "lazy"}
                  />
                </div>
              ))}
            </div>
            {photos.length > 1 && (
              <div class="thumbs">
                {photos.map((_p, i) => (
                  <a class="thumb" href={`#photo-${i + 1}`} aria-label={`写真${i + 1}枚目を表示`}>
                    {i + 1}
                  </a>
                ))}
              </div>
            )}
          </div>
        </>
      )
    }

    <!-- Meta -->
    <SectionLabel>商品の情報</SectionLabel>
    <dl class="meta">
      <div><dt>ブランド／販売店</dt><dd>{product.brand}</dd></div>
      <div><dt>カテゴリー</dt><dd>{product.category}</dd></div>
    </dl>

    <!-- Contact callout -->
    <aside class="callout bg-stripe">
      <div class="callout-title">⚐ 連絡について</div>
      <p>下のボタンで商品情報をコピーして、LINEで管理人にメッセージしてください。</p>
    </aside>

    <div class="bottom-spacer" aria-hidden="true"></div>

    <div slot="footer" class="footer-row">
      <div class="copy-wrap">
        <PrimaryButton
          kind="secondary"
          type="button"
          icon={Copy}
          name="copy"
          data-copy-trigger
        >
          情報をコピー
        </PrimaryButton>
        <span class="toast" data-copy-toast>コピー済み</span>
      </div>
      <div class="grow">
        <PrimaryButton as="a" href={lineUrl} kind="primary" icon={LinkIcon} full>
          LINEで連絡する
        </PrimaryButton>
      </div>
    </div>
  </AppShell>

  <script lang="ts" define:vars={{ message: lineMessage }}>
    document.querySelector("[data-copy-trigger]")?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(message);
        const toast = document.querySelector("[data-copy-toast]");
        toast?.classList.add("show");
        setTimeout(() => toast?.classList.remove("show"), 1800);
      } catch (e) {
        console.error("clipboard write failed", e);
      }
    });
  </script>
</BaseLayout>

<style>
  .title-block {
    padding: 20px 16px 14px;
    background: var(--color-card);
    border-bottom: 1.6px solid var(--color-line-soft);
  }

  .row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }

  .brand {
    font-size: 11px;
    letter-spacing: 1.5px;
    color: var(--color-primary);
    font-weight: 800;
    text-transform: uppercase;
  }

  .title {
    margin: 6px 0 12px;
    font-size: 22px;
    font-weight: 900;
    line-height: 1.3;
    letter-spacing: -0.3px;
  }

  .description {
    margin: 4px 16px 0;
    padding: 0 4px;
    font-size: 14px;
    line-height: 1.75;
    color: var(--color-ink);
    white-space: pre-line;
    text-wrap: pretty;
  }

  .photo-block {
    padding: 0 16px;
  }

  .photo-strip {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding: 4px 0;
  }
  .photo-strip::-webkit-scrollbar {
    display: none;
  }

  .photo-slide {
    flex: 0 0 100%;
    scroll-snap-align: center;
  }

  .thumbs {
    display: flex;
    gap: 6px;
    margin-top: 8px;
  }

  .thumb {
    flex: 1;
    aspect-ratio: 1 / 1;
    background-color: var(--color-paper-deep);
    background-image: repeating-linear-gradient(
      45deg,
      rgb(from var(--color-primary) r g b / 0.16) 0 1.2px,
      transparent 1.2px 6px
    );
    border: 1.4px solid var(--color-ink);
    border-radius: 6px;
    text-decoration: none;
    color: var(--color-ink);
    font-size: 11px;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .thumb:focus-visible,
  .thumb:hover {
    border-width: 2px;
  }

  .meta {
    margin: 0 16px;
    background: var(--color-card);
    border: 1.6px solid var(--color-ink);
    border-radius: 10px;
    overflow: hidden;
  }

  .meta > div {
    display: grid;
    grid-template-columns: 110px 1fr;
    padding: 10px 12px;
    border-bottom: 1px dashed var(--color-line-soft);
    font-size: 13px;
  }

  .meta > div:last-child {
    border-bottom: none;
  }

  .meta dt {
    color: var(--color-ink-soft);
    font-weight: 700;
    margin: 0;
  }

  .meta dd {
    color: var(--color-ink);
    font-weight: 500;
    margin: 0;
  }

  .callout {
    margin: 16px;
    padding: 14px;
    background-color: var(--color-primary-soft);
    --stripe-color: var(--color-primary);
    --stripe-opacity: 0.1;
    --stripe-size: 7px;
    border: 1.6px solid var(--color-ink);
    border-radius: 10px;
  }

  .callout-title {
    font-size: 12px;
    font-weight: 800;
    color: var(--color-primary-deep);
    letter-spacing: 0.5px;
  }

  .callout p {
    margin: 4px 0 0;
    font-size: 12px;
    color: var(--color-ink);
    line-height: 1.6;
  }

  .bottom-spacer {
    height: 16px;
  }

  .footer-row {
    display: flex;
    gap: 8px;
    align-items: stretch;
  }

  .copy-wrap {
    position: relative;
  }

  .footer-row .grow {
    flex: 1;
  }

  .toast {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 6px);
    transform: translateX(-50%) translateY(4px);
    background: var(--color-ink);
    color: var(--color-card);
    font-size: 11px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 999px;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 200ms ease,
      transform 200ms ease;
    white-space: nowrap;
  }

  .toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
</style>
