---
import AppShell from "../components/AppShell.astro";
import HeroBand from "../components/HeroBand.astro";
import ItemCard from "../components/ItemCard.astro";
import StatusTabs from "../components/StatusTabs.astro";
import EmptyState from "../components/EmptyState.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { countByStatus, listProductsWithCover } from "../lib/products";
import { isProductStatus, type ProductStatus } from "../lib/status";

const url = new URL(Astro.request.url);
const statusParam = url.searchParams.get("status");

let active: "all" | ProductStatus = "all";
if (
  statusParam &&
  isProductStatus(statusParam) &&
  (statusParam === "on_sale" || statusParam === "reserved" || statusParam === "sold")
) {
  active = statusParam;
}

const db = Astro.locals.runtime.env.DB;
const [items, counts] = await Promise.all([
  listProductsWithCover(db, {
    publicOnly: active === "all",
    status: active === "all" ? undefined : active,
  }),
  countByStatus(db, { publicOnly: true }),
]);

const totalPublic = counts.on_sale + counts.reserved + counts.sold;
---

<BaseLayout
  title="Nook 502 — 502号室のちいさな市場"
  description="友達と、暮らしのお下がり。Nook 502は知り合い向けの不要物譲渡フリマです。"
>
  <AppShell>
    <HeroBand count={totalPublic} />
    <StatusTabs active={active} counts={counts} />

    {
      items.length === 0 ? (
        <EmptyState />
      ) : (
        <div class="grid">
          {items.map((item, i) => (
            <ItemCard item={item} hero={i === 0} />
          ))}
        </div>
      )
    }

    <p class="footnote">© 502号室 · 友達同士の小さな譲渡市場</p>
  </AppShell>
</BaseLayout>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    padding: 4px 16px 24px;
  }

  .footnote {
    margin: 12px 16px 24px;
    text-align: center;
    font-size: 11px;
    color: var(--color-ink-muted);
  }
</style>
